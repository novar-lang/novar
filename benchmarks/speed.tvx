# Interpreter speed gates used by CI (see benchmarks/speed.sh). The limits there are about ten
# times the time these take on a laptop, so they only trip on a real regression.
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def loop_sum(n: int) -> int:
    s = 0
    i = 0
    while i < n:
        s += i * 2 % 7
        i += 1
    return s
