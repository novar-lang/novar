{
  "name": "telvax",
  "displayName": "Telvax",
  "description": "Language support for Telvax: syntax highlighting, diagnostics, hover, completion, go to definition and inferred-type hints.",
  "version": "0.0.5",
  "publisher": "telvax",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/telvax/telvax"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "telvax",
    "tensor",
    "mlops",
    "pipeline"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:telvax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "telvax",
        "aliases": [
          "Telvax",
          "telvax"
        ],
        "extensions": [
          ".tvx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "telvax",
        "scopeName": "source.telvax",
        "path": "./syntaxes/telvax.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Telvax",
      "properties": {
        "telvax.server.path": {
          "type": "string",
          "default": "telvax",
          "markdownDescription": "Path to the `telvax` executable. The extension starts it as `telvax lsp`."
        },
        "telvax.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "markdownDescription": "Arguments that make the executable speak the language server protocol."
        },
        "telvax.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    },
    "commands": [
      {
        "command": "telvax.restartServer",
        "title": "Telvax: Restart Language Server"
      }
    ],
    "configurationDefaults": {
      "[telvax]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.inlayHints.enabled": "on"
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "test:vscode": "node test/integration/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
