# Reads a CSV into a typed table, then summarises it with column methods and SQL.
# Run from the repository root: telvax run examples/dataframe/sales.tvx main

type Sale:
    id: Int
    region: Text
    units: Int
    price: Float

fn main():
    let sales: Table[Sale] = read_csv("examples/dataframe/sales.csv")
    print(f"rows: {sales.len()}")
    print(f"mean price: {sales.price.mean()}")

    let by_region: Table[{region: Text, revenue: Float}] = sales.sql("SELECT region, SUM(units * price) AS revenue FROM t GROUP BY region ORDER BY revenue DESC")
    for row in by_region:
        print(f"{row.region}: {row.revenue}")

    let big: Table[Sale] = sales.sql("SELECT * FROM t WHERE units >= 9")
    print(f"big sales: {big.len()}")
