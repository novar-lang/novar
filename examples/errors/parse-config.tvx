# Parses "key=value" lines with Result, Option, `?`, `if let` and tuples.
# Run from the repository root: telvax run examples/errors/parse-config.tvx main

fn split_pair(line: Text) -> Result[(Text, Text), Text]:
    let parts = line.split("=")
    if parts.len() != 2:
        return Err(f"bad line: {line}")
    Ok((parts[0].trim(), parts[1].trim()))

fn port_of(line: Text) -> Result[Int, Text]:
    let key, value = split_pair(line)?
    if key != "port":
        return Err(f"expected port, found {key}")
    match value.to_int():
        case Some(n):
            Ok(n)
        case None:
            Err(f"not a number: {value}")

fn main():
    for line in ["port = 8080", "host = local", "port = abc", "oops"]:
        match port_of(line):
            case Ok(p):
                print(f"ok: {p}")
            case Err(e):
                print(f"error: {e}")
    if "a b c".split(" ").first() is Some(first):
        print(f"first word: {first}")
