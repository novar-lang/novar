# Counts words in a text with a Map, then lists the most frequent ones.
# Run from the repository root: telvax run examples/text/word-count.tvx main

fn count_words(text: Text) -> Map[Text, Int]:
    let counts: Map[Text, Int] = std.map.new()
    for word in text.to_lowercase().split(" "):
        if word.is_empty():
            continue
        let seen = counts.get(word).unwrap_or(0)
        counts.insert(word, seen + 1)
    counts

fn main():
    let text = "the quick brown fox jumps over the lazy dog the end"
    let counts = count_words(text)
    print(f"distinct words: {counts.len()}")
    let the = counts.get("the").unwrap_or(0)
    print(f"the: {the}")

    var best = ""
    var best_n = 0
    for word, n in counts.entries():
        if n > best_n:
            best = word
            best_n = n
    print(f"most frequent: {best} ({best_n})")
