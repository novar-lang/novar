# Counts primes and prints a few facts. Runs interpreted (`telvax run`) or native (`telvax build`).

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d += 1
    return True

def main() -> int32:
    limit: int = 100
    count = 0
    for n in range(limit):
        if is_prime(n):
            count += 1
    print(f"primes below {limit}: {count}")

    squares = [1, 4, 9, 16, 25]
    sum = 0
    for s in squares:
        sum += s
    print(f"{squares.len()} squares add up to {sum}, the third is {squares[2]}")
    return count
