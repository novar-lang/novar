// Counts primes and prints a few facts. Runs interpreted (`telvax run`) or native (`telvax build`).

fn is_prime(n: i64) -> bool {
    if n < 2 { return false; }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 1;
    }
    true
}

fn main() -> i32 {
    let limit: i64 = 100;
    let mut count = 0;
    for n in 0..limit {
        if is_prime(n) { count += 1; }
    }
    std::io::println(f"primes below {limit}: {count}");

    let squares = [1, 4, 9, 16, 25];
    let mut sum = 0;
    for s in squares { sum += s; }
    std::io::println(f"{squares.len()} squares add up to {sum}, the third is {squares[2]}");
    count
}
