// Sieve of Eratosthenes with in-place array updates.
// Run it interpreted (`novar run examples/basics/sieve.nv main`) or native (`novar build`).

fn main() -> i32 {
    // Vec has no constructor for "n copies" yet, so start from a literal.
    let mut is_prime = [true, true, true, true, true, true, true, true, true, true,
        true, true, true, true, true, true, true, true, true, true,
        true, true, true, true, true, true, true, true, true, true];
    let n = is_prime.len();
    is_prime[0] = false;
    is_prime[1] = false;

    let mut p = 2;
    while p * p < n {
        if is_prime[p] {
            let mut multiple = p * p;
            while multiple < n {
                is_prime[multiple] = false;
                multiple += p;
            }
        }
        p += 1;
    }

    let mut line = "";
    let mut count = 0;
    for i in 0..n {
        if is_prime[i] {
            line = line + f"{i} ";
            count += 1;
        }
    }
    std::io::println(line);
    count
}
